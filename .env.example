# Environment variable template for InferenceGuard production deployment.
# Copy this file to .env and configure secret keys and model identifiers.
# Values control serving ports, hardware selection, and Hugging Face tokens.

PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
DEVICE=cpu

# Hugging Face Model Repositories
RISK_MODEL_ID=AT707/InferenceGuard-Roberta-Risk
REWRITER_MODEL_ID=AT707/inferenceguard-rewriter-v1

# Hugging Face Authentication Token
HF_TOKEN=your_huggingface_write_token_here

# Canned assistant replies and the global /debug/last_rewrite trace.
# Leave false anywhere a caller might act on the reply: the canned replies
# assert completed actions ("applied a one-time courtesy waiver"), and the
# debug trace is global rather than session-scoped, not per-caller.
IG_DEMO_MODE=false
